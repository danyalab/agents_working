# Copy to .env and fill in your own values. .env is gitignored.

# Google Cloud project + region used by Vertex AI and BigQuery
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1

# Vertex AI RAG corpus id (numeric id only — the cio_rag_agent assembles the
# full resource name projects/<project>/locations/<region>/ragCorpora/<id>)
RAG_CORPUS_ID=your-rag-corpus-id

# URL of the running MCP Toolbox for Databases server
TOOLBOX_URL=http://127.0.0.1:5000

# User identifier passed to AdkApp.stream_query when running locally
ADK_USER_ID=user-123
